[Unit]
Description=GLM-5.3 Flash K3 + DFlash2 on 2x RTX PRO 6000 Blackwell

[Service]
Type=simple
Environment=ENV_FILE=@ENV_FILE@
ExecStartPre=/usr/bin/docker info
ExecStart=@REPO_DIR@/scripts/serve.sh
ExecStartPost=@REPO_DIR@/scripts/wait-ready.py --base-url http://@READINESS_HOST@:@PORT@ --model @SERVED_MODEL_NAME@ --context @MAX_MODEL_LEN@ --timeout 4200 --container @CONTAINER_NAME@ --process-pid $MAINPID
ExecStop=/bin/kill -s INT $MAINPID
# EngineCore can fail while the foreground container wrapper exits zero.
Restart=always
RestartSec=10
TimeoutStartSec=4500
TimeoutStopSec=240
KillSignal=SIGINT

[Install]
WantedBy=default.target
