FROM local/glm53-runtime-fixes@sha256:ca68a67e14b77c4291a19925d7ff262ff63805cdd90834250ab7a6d7438a54a6

ARG RUNTIME_RECIPE_SHA256
LABEL io.github.glm53.runtime.recipe.sha256="${RUNTIME_RECIPE_SHA256}" \
      io.github.glm53.runtime.parent.recipe.sha256="4ef38e761892c69e7c8e90748dbc362dca405cd6cde756b4afafb68cc0babd39" \
      io.github.glm53.runtime.mixed-prefill="exact-policy-v1"

COPY runtime/apply-mixed-prefill-policy.py /usr/local/share/runtime-fixes/apply-mixed-prefill-policy.py
RUN chmod 0555 /usr/local/share/runtime-fixes/apply-mixed-prefill-policy.py \
 && test "${#RUNTIME_RECIPE_SHA256}" -eq 64 \
 && case "${RUNTIME_RECIPE_SHA256}" in \
      *[!0-9a-f]*) echo "invalid RUNTIME_RECIPE_SHA256" >&2; exit 1 ;; \
    esac \
 && python3 /usr/local/share/runtime-fixes/apply-mixed-prefill-policy.py \
      /usr/local/lib/python3.12/dist-packages \
 && python3 /usr/local/share/runtime-fixes/apply-mixed-prefill-policy.py \
      --verify /usr/local/lib/python3.12/dist-packages
