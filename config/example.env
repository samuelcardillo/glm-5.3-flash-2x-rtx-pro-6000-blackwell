# Required absolute paths
MODEL_DIR=/absolute/path/to/GLM-5.3-Flash-EXL3-K3-v1
DRAFT_DIR=/absolute/path/to/GLM-5.3-Flash-DFlash2
CACHE_DIR=/absolute/path/to/vllm-cache

# Exactly two physical host indices. Example excludes an RTX 5090 at index 1.
GPU_DEVICES=0,2

# Safe default. Use a specific trusted LAN/Tailnet address when remote clients
# need direct access; avoid 0.0.0.0 unless a firewall controls the port.
BIND_ADDRESS=127.0.0.1
PORT=8000
CONTAINER_NAME=glm53-flash-2x-rtxpro6000
SERVED_MODEL_NAME=glm-5.3-flash-local
RUNTIME_IMAGE=ghcr.io/tpurtell/glm-5.3-flash-exl3-4bpw-2x-rtx:v0.6.0@sha256:fe249b88d091430d8a88cd987d087d556053f0f067a649f2e9ca95895129e82b

# Qualified tpurtell v0.6 profile
MAX_MODEL_LEN=1048576
MAX_NUM_BATCHED_TOKENS=2048
MAX_NUM_SEQS=16
GPU_MEMORY_UTILIZATION=0.950
KV_CACHE_DTYPE=fp8_ds_mla
MAX_IMAGES_PER_PROMPT=16
MAX_VIDEOS_PER_PROMPT=0
ENABLE_PREFIX_CACHING=1
ENABLE_EXPERT_PARALLEL=1
DECODE_CONTEXT_PARALLEL_SIZE=2

# Replicated DFlash2 draft cache. ReplaySSM and native MTP are not used.
# DFlash2 is CC BY-NC-ND 4.0 research/evaluation only; commercial use requires
# separate permission from Inco AI. Review its terms, then change 0 to 1.
ACCEPT_DFLASH2_RESEARCH_LICENSE=0
DFLASH_TOKENS=5
DFLASH_KV_CACHE_DTYPE=bfloat16
NCCL_DEBUG=WARN
